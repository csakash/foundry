# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Voice (required for narration) ---
ELEVENLABS_API_KEY=            # elevenlabs.io — TTS; locked persona voices in personas/

# --- Video & image generation ---
FAL_KEY=                       # fal.ai — image/video gen (Lane C)
HF_KEY=                        # console.higgsfield.ai — <key_id>:<secret>. When set and accepted, video uses the
                               # Higgsfield API; otherwise the Higgsfield MCP connector. (Or HF_API_KEY + HF_API_SECRET.)
GOOGLE_API_KEY=                # Gemini — reel analysis + Nano Banana image generation
OPENAI_API_KEY=                # optional — ChatGPT image generation fallback

# --- Scraping & inspiration ---
APIFY_TOKEN=                   # apify.com — reel/profile scraping (or use the Apify MCP instead)

# --- Stock assets ---
PEXELS_API_KEY=                # optional — stock b-roll fallback
